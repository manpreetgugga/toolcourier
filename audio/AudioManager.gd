class_name AudioManager
extends Node
## Plays the game's sounds: named sound effects on the SFX bus and a calm
## ambient loop per world on the Music bus, faded across when the world
## changes. Volumes follow Settings. Every sound is generated by
## tools/make_audio.gd.
##
## The player itself is the autoload "Audio"; everything else calls the
## static functions, which do nothing until it is there (so scripts that
## run before the autoloads, like the tools, still compile and run).
##
##   AudioManager.play(&"step")
##   AudioManager.play_music(2)

const CUES: Array[StringName] = [
	&"step", &"tap", &"slide", &"rotate", &"snap", &"pickup", &"drop", &"pad_complete",
	&"level_complete", &"ui_click", &"error", &"glide", &"creak", &"fall", &"whoosh", &"bounce",
]
## Playback level of each cue (dB), so frequent ones sit back in the mix.
const GAIN: Dictionary = {
	&"step": -14.0, &"tap": -9.0, &"slide": -5.0, &"rotate": -6.0, &"snap": -4.0, &"pickup": -5.0,
	&"drop": -6.0, &"pad_complete": -4.0, &"level_complete": -3.0, &"ui_click": -8.0, &"error": -8.0,
	&"glide": -12.0, &"creak": -11.0, &"fall": -6.0, &"whoosh": -14.0, &"bounce": -7.0,
}
## Random pitch spread of each cue, so repeats don't sound mechanical.
const JITTER: Dictionary = {&"step": 0.08, &"tap": 0.05, &"creak": 0.1, &"glide": 0.06, &"ui_click": 0.03, &"bounce": 0.06}
const VOICES: int = 10
## The same cue again within this many milliseconds is dropped.
const REPEAT_MSEC: int = 35
const MUSIC_FADE: float = 1.6
## How far the music dips under the finish jingle.
const DUCK_DB: float = -9.0

static var _instance: AudioManager

## The last cues played, newest last (tests read it).
var history: Array[StringName] = []
## World whose loop is playing (0 for none).
var music_world: int = 0

var _streams: Dictionary = {}
var _voices: Array[AudioStreamPlayer] = []
var _next_voice: int = 0
var _last_played: Dictionary = {}
var _music: Array[AudioStreamPlayer] = []
var _music_index: int = 0
var _music_tweens: Array[Tween] = [null, null]
var _duck: Tween


func _ready() -> void:
	_instance = self
	process_mode = Node.PROCESS_MODE_ALWAYS
	for cue: StringName in CUES:
		_streams[cue] = load("res://audio/sfx/%s.wav" % cue)
	for i in VOICES:
		var voice := AudioStreamPlayer.new()
		voice.bus = &"SFX"
		add_child(voice)
		_voices.append(voice)
	for i in 2:
		var player := AudioStreamPlayer.new()
		player.bus = &"Music"
		player.volume_db = -80.0
		add_child(player)
		_music.append(player)
	Settings.ensure_loaded()
	Settings.events.changed.connect(_on_setting_changed)
	_apply_volumes()


func _exit_tree() -> void:
	if _instance == self:
		_instance = null


## Plays [param cue] (one of [constant CUES]), [param volume_db] louder or
## quieter than its usual level.
static func play(cue: StringName, volume_db: float = 0.0) -> void:
	if _instance:
		_instance._play(cue, volume_db)


## Fades over to world [param world]'s loop (0 fades the music out).
static func play_music(world: int) -> void:
	if _instance:
		_instance._play_music(world)


## Dips the music for [param seconds] (under the finish jingle).
static func duck(seconds: float = 2.4) -> void:
	if _instance:
		_instance._duck_music(seconds)


## Whether [param cue] was played within the last [param count] cues.
static func played(cue: StringName, count: int = 64) -> bool:
	return _instance != null and _instance.history.slice(-count).has(cue)


## World whose loop is playing (0 for none).
static func current_music() -> int:
	return _instance.music_world if _instance else 0


func _play(cue: StringName, volume_db: float) -> void:
	var stream: AudioStream = _streams.get(cue)
	if stream == null:
		push_warning("AudioManager: no cue %s" % cue)
		return
	var now: int = Time.get_ticks_msec()
	if now - int(_last_played.get(cue, -100000)) < REPEAT_MSEC:
		return
	_last_played[cue] = now
	history.append(cue)
	if history.size() > 64:
		history.pop_front()
	var voice: AudioStreamPlayer = _free_voice()
	voice.stream = stream
	voice.volume_db = GAIN.get(cue, 0.0) + volume_db
	var jitter: float = JITTER.get(cue, 0.0)
	voice.pitch_scale = 1.0 + randf_range(-jitter, jitter)
	voice.play()


func _play_music(world: int) -> void:
	if world == music_world:
		return
	music_world = world
	_fade(_music_index, -80.0, true)
	if world <= 0:
		return
	var path: String = "res://audio/music/world_%d.wav" % world
	if not ResourceLoader.exists(path):
		return
	_music_index = 1 - _music_index
	var player: AudioStreamPlayer = _music[_music_index]
	var stream := load(path) as AudioStreamWAV
	_loop(stream)
	player.stream = stream
	player.volume_db = -40.0
	player.play()
	_fade(_music_index, 0.0, false)


func _duck_music(seconds: float) -> void:
	if _duck:
		_duck.kill()
	var bus: int = AudioServer.get_bus_index(&"Music")
	var base: float = Settings.volume_db(Settings.music)
	_duck = create_tween()
	_duck.tween_method(func(db: float) -> void: AudioServer.set_bus_volume_db(bus, db), base, base + DUCK_DB, 0.25)
	_duck.tween_interval(seconds)
	_duck.tween_method(func(db: float) -> void: AudioServer.set_bus_volume_db(bus, db), base + DUCK_DB, base, 1.5)


func _free_voice() -> AudioStreamPlayer:
	for voice: AudioStreamPlayer in _voices:
		if not voice.playing:
			return voice
	_next_voice = (_next_voice + 1) % _voices.size()
	return _voices[_next_voice]


func _fade(index: int, to_db: float, stop_after: bool) -> void:
	if _music_tweens[index]:
		_music_tweens[index].kill()
	var player: AudioStreamPlayer = _music[index]
	var tween: Tween = create_tween()
	tween.tween_property(player, "volume_db", to_db, MUSIC_FADE).set_trans(Tween.TRANS_SINE) \
		.set_ease(Tween.EASE_OUT if to_db > -1.0 else Tween.EASE_IN)
	if stop_after:
		tween.tween_callback(player.stop)
	_music_tweens[index] = tween


## Makes a loop run on forever (the generated loops are seamless end to start).
static func _loop(stream: AudioStreamWAV) -> void:
	if stream == null or stream.loop_mode == AudioStreamWAV.LOOP_FORWARD:
		return
	stream.loop_mode = AudioStreamWAV.LOOP_FORWARD
	stream.loop_begin = 0
	stream.loop_end = roundi(stream.get_length() * stream.mix_rate)


func _on_setting_changed(key: StringName) -> void:
	if key in [&"music", &"sfx"]:
		_apply_volumes()


func _apply_volumes() -> void:
	AudioServer.set_bus_volume_db(AudioServer.get_bus_index(&"Music"), Settings.volume_db(Settings.music))
	AudioServer.set_bus_volume_db(AudioServer.get_bus_index(&"SFX"), Settings.volume_db(Settings.sfx))
