<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Registers the plugin with Godot: Engine.get_singleton("TinyCourierFirebase"). -->
        <meta-data
            android:name="org.godotengine.plugin.v2.TinyCourierFirebase"
            android:value="com.manpreetgugga.tinycourier.firebase.TinyCourierFirebase" />

        <!-- Nothing is collected until the game says so (see core/Analytics.gd:
             at once where no consent is needed, or once the player agrees).
             Its answer is kept from then on, so it holds from the next start. -->
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />

        <!-- Google's consent mode starts with everything denied; the game
             grants what applies. Analytics data is never used to personalize
             ads. -->
        <meta-data
            android:name="google_analytics_default_allow_analytics_storage"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_storage"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_user_data"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_personalization_signals"
            android:value="false" />

        <!-- The game is one Android screen; it reports its own screens. -->
        <meta-data
            android:name="google_analytics_automatic_screen_reporting_enabled"
            android:value="false" />
    </application>
</manifest>
